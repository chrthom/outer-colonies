{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "read", "resource": "/tmp/*", "effect": "allow" },
    // In OpenCode V2, `edit` covers the `edit`, `write`, and `patch` tools; `write` is included explicitly as well.
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" },
    { "action": "write", "resource": "/tmp/*", "effect": "allow" },
  ],
}
